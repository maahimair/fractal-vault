# ─── Fractal Vault — Environment Template ──────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Generate strong secrets (run once, store the output in your .env):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Node.js Gateway ───────────────────────────────────────────────────────────

# Signing key for /token JWTs. Minimum 32 random bytes (64 hex chars).
JWT_SECRET=

# Shared secret between the Node gateway and the Flask backend.
# Must be byte-identical to FLASK_INTERNAL_API_KEY below.
INTERNAL_API_KEY=

# Credentials accepted by the POST /token demo endpoint.
DEMO_USER=
DEMO_PASS=

# Where the gateway reaches the Flask backend (gateway's point of view).
BACKEND_URL=http://127.0.0.1:5000

# Comma-separated browser origins allowed by CORS. No spaces.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Port the gateway binds to.
GATEWAY_PORT=3000

# ── Flask Backend ─────────────────────────────────────────────────────────────

# Shared secret for X-Internal-Key. Must match INTERNAL_API_KEY exactly.
FLASK_INTERNAL_API_KEY=

# Origins permitted to call Flask directly.
FLASK_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# "true" only for local development. Never enable in production — it exposes
# the Werkzeug debugger and executes arbitrary code on request.
FLASK_DEBUG=false

# API key protecting the GET /logs endpoint (X-API-Key header).
LOG_API_KEY=

# ── Simulator ─────────────────────────────────────────────────────────────────

# Credentials the simulator uses against POST /token. Defaults to the demo
# credentials above, but override them here so the simulator never hardcodes
# a secret in source control.
SIM_USER=
SIM_PASS=

SIM_TOKEN_URL=http://127.0.0.1:3000/token
SIM_TRUST_URL=http://127.0.0.1:3000/check-trust